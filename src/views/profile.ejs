<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/meta') %>
    <link rel="stylesheet" href="/css/app.css">
    <title>Profile — SPENDwise</title>
</head>
<body class="app-body">

    <%- include('partials/app-nav', { activeNav: 'profile' }) %>

    <main class="app-main">
        <div class="app-topbar">
            <div>
                <h1 class="page-title">Profile Settings</h1>
                <p class="page-sub">Manage your account, security, and data.</p>
            </div>
        </div>

        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <div class="profile-header">
                <div class="profile-avatar"><%= (user.firstName[0] + user.lastName[0]).toUpperCase() %></div>
                <div>
                    <h2 style="margin-bottom:2px;">
                        <%= user.firstName %> <%= user.lastName %>
                        <span class="role-badge">
                            <i class="fa-solid <%= user.role === 'admin' ? 'fa-user-shield' : 'fa-user' %>">
                            </i> <%= user.role === 'admin' ? 'Admin' : 'Member' %>
                        </span>
                    </h2>
                    <p class="note" style="margin:0;">
                        @<%= user.username %> &middot; Member since <%= user.createdAt.toISOString().slice(0,10) %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Personal information -->
        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <div class="card-section-head">
                <h3><i class="fa-solid fa-id-card"></i> Personal Information</h3>
                <button type="button" class="btn btn-ghost btn-sm <%= profileError ? 'hidden' : '' %>" data-toggle-edit="personal-info" id="personal-info-edit-btn">
                    <i class="fa-solid fa-pen"></i> Edit
                </button>
            </div>

            <% if (profileSuccess) { %>
                <p class="success"><i class="fa-solid fa-circle-check"></i> <%= profileSuccess %></p>
            <% } %>

            <div id="personal-info-view" class="info-grid <%= profileError ? 'hidden' : '' %>">
                <div class="info-item"><span class="label">
                    First name</span><span class="value"><%= user.firstName %></span>
                </div>
                <div class="info-item"><span class="label">
                    Last name</span><span class="value"><%= user.lastName %></span>
                </div>
                <div class="info-item">
                    <span class="label">Email</span><span class="value"><%= user.email %></span>
                </div>
                <div class="info-item">
                    <span class="label">Monthly budget</span>
                    <span class="value">$<%= Number(user.monthlyBudget || 0).toFixed(2) %></span>
                </div>
            </div>

            <form method="POST" action="/profile" class="form-grid <%= profileError ? '' : 'hidden' %>" id="personal-info-form" style="margin-top: var(--space-3);">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (profileError) { %>
                    <p class="error"><i class="fa-solid fa-circle-exclamation"></i> <%= profileError %></p>
                <% } %>
                <div class="field-row" style="display:grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
                    <div class="form-field">
                        <label for="first_name">First name</label>
                        <input type="text" id="first_name" name="first_name" value="<%= user.firstName %>" required>
                    </div>
                    <div class="form-field">
                        <label for="last_name">Last name</label>
                        <input type="text" id="last_name" name="last_name" value="<%= user.lastName %>" required>
                    </div>
                </div>
                <div class="form-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= user.email %>" required>
                </div>
                <div class="form-field">
                    <label for="monthly_budget">Monthly budget</label>
                    <input type="number" step="0.01" min="0" id="monthly_budget" name="monthly_budget" value="<%= user.monthlyBudget || 0 %>" required>
                </div>
                <div style="display:flex; gap: 0.75rem;">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check"></i> Save changes</button>
                    <button type="button" class="btn btn-ghost" data-toggle-cancel="personal-info">Cancel</button>
                </div>
            </form>
        </div>

        <!-- Change password -->
        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <h3><i class="fa-solid fa-lock"></i> Change Password</h3>
            <% if (passwordError) { %><p class="error"><i class="fa-solid fa-circle-exclamation"></i> <%= passwordError %></p><% } %>
            <% if (passwordSuccess) { %><p class="success"><i class="fa-solid fa-circle-check"></i> <%= passwordSuccess %></p><% } %>
            <form method="POST" action="/profile/password" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-field">
                    <label for="current_password">Current password</label>
                    <input type="password" id="current_password" name="current_password" required>
                </div>
                <div class="form-field">
                    <label for="new_password">New password</label>
                    <input type="password" id="new_password" name="new_password" required>
                    <div class="strength-meter" id="strength-meter" data-level="0" style="margin-top:6px;">
                        <div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div>
                    </div>
                    <p class="strength-label" id="strength-label"></p>
                </div>
                <div class="form-field">
                    <label for="confirm_password">Confirm new password</label>
                    <input type="password" id="confirm_password" name="confirm_password" required>
                </div>
                <button type="submit" class="btn btn-primary" style="justify-self: start;">
                    <i class="fa-solid fa-key"></i> Change password
                </button>
            </form>
        </div>

        <!-- Export -->
        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <h3><i class="fa-solid fa-file-export"></i> Export Your Data</h3>
            <p class="note">Download your data as a CSV file, any time.</p>
            <div style="display:flex; gap: var(--space-3); flex-wrap: wrap;">
                <a href="/export/transactions" class="btn btn-ghost"><i class="fa-solid fa-receipt"></i> All transactions (CSV)</a>
                <a href="/export/summary" class="btn btn-ghost"><i class="fa-solid fa-chart-column"></i> Monthly summary (CSV)</a>
            </div>
        </div>

        <!-- Danger zone -->
        <div class="glass-card danger-zone-card">
            <h3 style="color: var(--color-danger);"><i class="fa-solid fa-triangle-exclamation"></i> Delete Account</h3>
            <% if (typeof deleteError !== 'undefined' && deleteError) { %>
                <p class="error"><i class="fa-solid fa-circle-exclamation"></i> <%= deleteError %></p>
            <% } %>
            <p class="note">This permanently deletes your account and all transactions, budgets, and savings goals. This cannot be undone.</p>
            <form method="POST" action="/profile/delete" class="form-grid" onsubmit="return confirm('This will permanently delete your account and all your data. Are you sure?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-field">
                    <label for="delete_password">Password</label>
                    <input type="password" id="delete_password" name="password" required>
                </div>
                <div class="form-field">
                    <label for="confirm_text">Type DELETE to confirm</label>
                    <input type="text" id="confirm_text" name="confirm_text" required>
                </div>
                <button type="submit" class="btn btn-danger" style="justify-self: start;">
                    <i class="fa-solid fa-trash"></i> Delete my account
                </button>
            </form>
        </div>
    </main>

    <script src="/js/section-toggle.js"></script>
    <script src="/js/password-strength.js"></script>
</body>
</html>
