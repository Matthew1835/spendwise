<div class="modal-overlay" id="category-modal">
    <div class="modal-box">
        <h2 id="cat-modal-title"><i class="fa-solid fa-circle-plus"></i> Add category</h2>
        <form method="POST" action="/admin/categories" class="form-grid" id="cat-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-field">
                <label for="cat_category_name">Name</label>
                <input type="text" id="cat_category_name" name="category_name" required>
            </div>

            <div class="form-field">
                <label for="cat_category_type">Type</label>
                <select id="cat_category_type" name="category_type" required>
                    <option value="expense">Expense</option>
                    <option value="income">Income</option>
                </select>
            </div>

            <div class="form-field">
                <label for="cat_description">Description <span class="note">(optional)</span></label>
                <input type="text" id="cat_description" name="description">
            </div>

            <div class="field-row" style="display:grid; grid-template-columns: 1fr 2fr; gap: var(--space-3);">
                <div class="form-field">
                    <label for="cat_color_code">Color</label>
                    <input type="color" id="cat_color_code" name="color_code" value="#0A3D2E" style="height: 42px; padding: 4px;">
                </div>
                <div class="form-field">
                    <label for="cat_icon">Icon <span class="note">(Font Awesome class)</span></label>
                    <input type="text" id="cat_icon" name="icon" value="fa-solid fa-tag" placeholder="e.g. fa-solid fa-cart-shopping">
                </div>
            </div>

            <div style="display:flex; gap: 0.75rem;">
                <button type="submit" class="btn btn-primary" style="flex:1; justify-content:center;" id="cat-submit-btn">
                    <i class="fa-solid fa-check"></i> Add category
                </button>
                <button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
            </div>
        </form>
    </div>
</div>
