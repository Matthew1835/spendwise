<div class="modal-overlay" id="keyword-modal">
    <div class="modal-box">
        <h2 id="kw-modal-title"><i class="fa-solid fa-circle-plus"></i> Add keyword rule</h2>
        <form method="POST" action="/admin/keywords" class="form-grid" id="kw-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-field">
                <label for="kw_keyword">Keyword</label>
                <input type="text" id="kw_keyword" name="keyword" required>
            </div>

            <div class="form-field">
                <label for="kw_category_id">Category</label>
                <select id="kw_category_id" name="category_id" required>
                    <% categories.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.categoryName %></option>
                    <% }) %>
                </select>
            </div>

            <div class="form-field">
                <label for="kw_priority">Priority <span class="note">(0–100)</span></label>
                <input type="number" id="kw_priority" name="priority" min="0" max="100" value="1">
            </div>

            <div class="form-field">
                <label for="kw_rule_type">Rule type</label>
                <select id="kw_rule_type" name="rule_type">
                    <option value="contains">Contains</option>
                    <option value="exact_match">Exact match</option>
                    <option value="starts_with">Starts with</option>
                </select>
            </div>

            <div style="display:flex; gap: 0.75rem;">
                <button type="submit" class="btn btn-primary" style="flex:1; justify-content:center;" id="kw-submit-btn">
                    <i class="fa-solid fa-check"></i> Add rule
                </button>
                <button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
            </div>
        </form>
    </div>
</div>
