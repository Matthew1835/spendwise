<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/meta') %>
    <link rel="stylesheet" href="/css/app.css">
    <title>Dashboard — SPENDwise</title>
</head>
<body class="app-body">

    <%- include('partials/app-nav', { activeNav: 'dashboard' }) %>

    <main class="app-main">
        <div class="app-topbar">
            <div>
                <h1 class="page-title">Hi, <%= currentUser.firstName %> 👋</h1>
                <p class="page-sub">Here's your financial overview for <%= monthLabel %>.</p>
            </div>
            <button type="button" class="btn btn-gold" data-modal-target="transaction-modal" data-tx-add>
                <i class="fa-solid fa-circle-plus"></i> Add transaction
            </button>
        </div>

        <div class="card-grid">
            <div class="stat-card stat-income">
                <div class="stat-icon"><i class="fa-solid fa-arrow-down"></i></div>
                <span class="stat-value">$<%= stats.totalIncome.toFixed(2) %></span>
                <span class="stat-label">Income this month</span>
            </div>
            <div class="stat-card stat-expense">
                <div class="stat-icon"><i class="fa-solid fa-arrow-up"></i></div>
                <span class="stat-value">$<%= stats.totalExpense.toFixed(2) %></span>
                <span class="stat-label">Expenses this month</span>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-scale-balanced"></i></div>
                <span class="stat-value">$<%= stats.netBalance.toFixed(2) %></span>
                <span class="stat-label">Net balance</span>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-piggy-bank"></i></div>
                <span class="stat-value">$<%= stats.availableBalance.toFixed(2) %></span>
                <span class="stat-label">Available after savings</span>
            </div>
        </div>

        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <h3>Income vs. Expense — last 6 months</h3>
            <div class="chart-wrap">
                <canvas id="trendChart" aria-label="Income versus expense over the last 6 months" role="img"></canvas>
            </div>
        </div>

        <div class="chart-and-table-row">
            <div class="glass-card">
                <h3>Spending by category</h3>
                <% if (expenseByCategory.length === 0) { %>
                    <p class="note">No expenses recorded this month yet.</p>
                <% } %>
                <div class="chart-wrap chart-wrap--pie">
                    <canvas id="categoryChart" aria-label="Expense breakdown by category" role="img"></canvas>
                </div>
            </div>

            <div class="glass-card">
                <div class="card-section-head">
                    <h3>Recent transactions</h3>
                    <a href="/transactions" class="btn btn-ghost btn-sm">View all <i class="fa-solid fa-arrow-right"></i></a>
                </div>
                <% if (recentTransactions.length === 0) { %>
                    <p class="note">No transactions yet — add your first one to get started.</p>
                <% } else { %>
                    <div class="table-scroll table-scroll--fixed">
                        <table class="data-table data-table--compact">
                            <thead>
                                <tr><th>Date</th><th>Category</th><th class="text-right col-amount">Amount</th></tr>
                            </thead>
                            <tbody>
                                <% recentTransactions.forEach(t => { %>
                                <tr>
                                    <td><%= t.transactionDate.toISOString().slice(0,10) %></td>
                                    <td><%= t.category ? t.category.categoryName : 'Uncategorized' %></td>
                                    <td class="text-right font-bold <%= t.transactionType === 'income' ? 'text-income' : 'text-expense' %>">
                                    <%= t.transactionType === 'income' ? '+' : '-' %>$<%= Number(t.amount).toFixed(2) %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="glass-card">
            <h3>Monthly overview</h3>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr><th>Month</th><th>Income</th><th>Expense</th><th>Savings</th><th>Net</th></tr>
                    </thead>
                    <tbody>
                        <% trend.forEach(m => { %>
                        <tr>
                            <td class="font-bold"><%= m.label %></td>
                            <td class="text-income">$<%= m.income.toFixed(2) %></td>
                            <td class="text-expense">$<%= m.expense.toFixed(2) %></td>
                            <td>$<%= m.savings.toFixed(2) %></td>
                            <td class="font-bold">$<%= m.net.toFixed(2) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('partials/transaction-modal', { categories, returnTo: '/dashboard' }) %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        window.__DASHBOARD_DATA__ = {
            trend: <%- JSON.stringify(trend) %>,
            expenseByCategory: <%- JSON.stringify(expenseByCategory) %>,
        };
    </script>
    <script src="/js/chart-utils.js"></script>
    <script src="/js/dashboard-charts.js"></script>
    <script src="/js/modal.js"></script>
    <script src="/js/transaction-form.js"></script>
</body>
</html>
