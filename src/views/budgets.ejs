<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/meta') %>
    <link rel="stylesheet" href="/css/app.css">
    <title>Budgets — SPENDwise</title>
</head>
<body class="app-body">

    <%- include('partials/app-nav', { activeNav: 'budgets' }) %>

    <main class="app-main">
        <div class="app-topbar">
            <div>
                <h1 class="page-title">Budgets</h1>
                <p class="page-sub">Set spending limits by category and keep an eye on where you stand.</p>
            </div>
            <button type="button" class="btn btn-gold" data-modal-target="budget-modal" data-bg-add>
                <i class="fa-solid fa-circle-plus"></i> Add budget
            </button>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="form-alert form-alert--error" style="margin-bottom: var(--space-4);">
                <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
            </div>
        <% } %>

        <div class="card-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-wallet"></i></div>
                <span class="stat-value">$<%= totals.totalBudget.toFixed(2) %></span>
                <span class="stat-label">Total budgeted</span>
            </div>
            <div class="stat-card stat-expense">
                <div class="stat-icon"><i class="fa-solid fa-fire"></i></div>
                <span class="stat-value">$<%= totals.totalSpent.toFixed(2) %></span>
                <span class="stat-label">Total spent</span>
            </div>
            <div class="stat-card <%= totals.totalRemaining < 0 ? 'stat-expense' : 'stat-income' %>">
                <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
                <span class="stat-value">$<%= totals.totalRemaining.toFixed(2) %></span>
                <span class="stat-label">Remaining</span>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-chart-pie"></i></div>
                <span class="stat-value"><%= totals.overallProgress.toFixed(0) %>%</span>
                <span class="stat-label">Overall progress</span>
            </div>
        </div>

        <div class="glass-card" style="margin-bottom: var(--space-5);">
            <div class="card-section-head">
                <h3>Budget vs. spending</h3>
                <div style="display:flex; gap: var(--space-2); align-items:center;">
                    <select id="budget-chart-category" class="form-field" 
                        style="padding: 0.4rem 0.7rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
                        <option value="">All categories</option>
                        <% categories.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.categoryName %></option>
                        <% }) %>
                    </select>
                    <button type="button" id="budget-chart-reset" class="btn btn-ghost btn-sm">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                </div>
            </div>
            <% if (budgets.length === 0) { %>
                <p class="note">Add a budget to see it charted here.</p>
            <% } else { %>
                <div class="chart-wrap">
                    <canvas id="budgetChart" aria-label="Budgeted versus spent amount per budget" role="img"></canvas>
                </div>            
            <% } %>
        </div>

        <% if (budgets.length === 0) { %>
            <div class="glass-card"><p class="note">No budgets yet — add one to start tracking against a spending limit.</p></div>
        <% } else { %>
            <div class="entity-card-grid">
                <% budgets.forEach(b => { %>
                    <div class="entity-card <%= b.isOverBudget ? 'is-over' : '' %>">
                        <div class="entity-card-head">
                            <div class="entity-card-title">
                                <i class="fa-solid fa-tag"></i>
                                <%= b.category ? b.category.categoryName : 'Uncategorized' %>
                                <% if (b.isOverBudget) { %>
                                    <span class="alert-badge"><i class="fa-solid fa-triangle-exclamation"></i> Over</span>
                                <% } else if (b.isOverThreshold) { %>
                                    <span class="alert-badge" style="background: rgba(255,169,77,0.18); color: var(--color-warning);">
                                        <i class="fa-solid fa-bell"></i> Alert
                                    </span>
                                <% } %>
                            </div>
                            <div class="entity-card-actions">
                                <button
                                    type="button" class="btn btn-icon btn-ghost" title="Edit"
                                    data-modal-target="budget-modal" data-bg-edit
                                    data-id="<%= b.id %>"
                                    data-category-id="<%= b.categoryId %>"
                                    data-budget-amount="<%= b.budgetAmount %>"
                                    data-period-type="<%= b.periodType %>"
                                    data-start-date="<%= b.startDate.toISOString().slice(0,10) %>"
                                    data-end-date="<%= b.endDate.toISOString().slice(0,10) %>"
                                    data-alert-threshold="<%= b.alertThreshold %>"
                                ><i class="fa-solid fa-pen"></i></button>
                                <form method="POST" action="/budgets/<%= b.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this budget?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-icon btn-ghost" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="entity-stats-row">
                            <div class="stat-block">
                                <span class="label">Budget</span>
                                <span class="value">$<%= Number(b.budgetAmount).toFixed(2) %></span>
                            </div>
                            <div class="stat-block" style="text-align:right;">
                                <span class="label">Spent</span>
                                <span class="value <%= b.isOverBudget ? 'text-expense' : '' %>">$<%= b.spentAmount.toFixed(2) %></span>
                            </div>
                        </div>

                        <div class="progress-track">
                            <div class="progress-fill <%= b.isOverBudget ? 'danger' : (b.isOverThreshold ? 'warn' : '') %>" style="width: <%= Math.min(b.percentUsed, 100) %>%"></div>
                        </div>

                        <div class="entity-meta">
                            <span><%= b.percentUsed.toFixed(0) %>% used</span>
                            <span><%= b.isOverBudget ? 'Over by $' + (b.spentAmount - Number(b.budgetAmount)).toFixed(2) : '$' + (Number(b.budgetAmount) - b.spentAmount).toFixed(2) + ' left' %></span>
                        </div>
                        <div class="entity-meta">
                            <span><%= b.startDate.toISOString().slice(0,10) %> – <%= b.endDate.toISOString().slice(0,10) %></span>
                            <span><%= b.transactionCount %> transaction<%= b.transactionCount === 1 ? '' : 's' %></span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <%- include('partials/budget-modal', { categories }) %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        window.__BUDGETS_CHART_DATA__ = <%- JSON.stringify(budgets.map(b => ({
            label: (b.category ? b.category.categoryName : 'Uncategorized') + ' (' + b.startDate.toISOString().slice(0,10) + ')',
            categoryId: b.categoryId,
            budgetAmount: Number(b.budgetAmount),
            spentAmount: b.spentAmount,
        }))) %>;
    </script>
    <script src="/js/chart-utils.js"></script>
    <script src="/js/budget-chart.js"></script>
    <script src="/js/modal.js"></script>
    <script src="/js/budget-form.js"></script>
</body>
</html>